# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Saved plans: the binary format holds every planned value, secrets included.
# HashiCorp rates them as sensitive as the state file itself.
*.tfplan
*.tfplan.json

# Override files are local by design (HashiCorp docs): they must never be
# committed, or they silently redirect the backend on someone else's machine.
*_override.tf

# Partial backend configuration: holds the bucket name, hence the AWS account id.
backend.hcl
!backend.hcl.example

# Secrets / environment
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials

# Local output (plan logs, screenshots)
out/

# Generated by `make inventory` from terraform output.
ansible/inventory.generated.ini

# Python bytecode
__pycache__/
*.pyc
