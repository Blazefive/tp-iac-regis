# Copy to terraform.tfvars (git-ignored) and fill the three required values:
#
#   cp terraform.tfvars.example terraform.tfvars
#   make ip        # prints your public IP as a /32
#
# Every other value below is also the default in variables.tf, repeated here so
# one file shows the whole configuration surface. The state bucket is not here:
# a backend block accepts no variables, see backend.hcl.example.

# ---- Required ---------------------------------------------------------------

# Your public IP as a /32. Never 0.0.0.0/0 - two validation blocks reject it.
admin_cidr = "SET_ME/32"

# Public key of the Ansible control node, so configuration management can reach
# the instance:  cat ~/.ssh/id_ed25519.pub
ansible_control_public_key = "ssh-ed25519 AAAA... ansible-control@host"

# Existing VPC, read as a data source and never managed.
vpc_id = "vpc-SET_ME"

# ---- Identity and placement -------------------------------------------------

# The training account is shared: put your name here or collide with a
# classmate on the security group and key pair names.
project       = "tp-iac-regis"
owner         = "Blazefive"
instance_name = "Régis"

region                   = "eu-west-3" # Paris
availability_zone_suffix = "a"         # -> eu-west-3a

# ---- Network ----------------------------------------------------------------

# Must sit inside the VPC range and overlap no existing subnet. Check first:
#   aws ec2 describe-subnets --filters Name=vpc-id,Values=<vpc> \
#     --query 'Subnets[].CidrBlock'
public_subnet_cidr = "172.31.50.0/24"

# Sources allowed on each service port. null means "same as admin_cidr", the
# fail-safe default: opening to the internet has to be written down.
http_cidr = null
game_port = 8080
game_cidr = null

# ---- Compute ----------------------------------------------------------------

# t2.micro: the only type covered by the legacy 750 h/month free tier.
instance_type       = "t2.micro"
root_volume_type    = "gp3"
root_volume_size_gb = 10

ssh_public_key_path = "~/.ssh/tp2_ed25519.pub"

# ---- Image ------------------------------------------------------------------

# 099720109477 is Canonical. Never resolve an AMI without pinning its owner:
# the name filter alone can be satisfied by anyone. The name is an exact build,
# not a wildcard - see the note in variables.tf.
ami_owner_id     = "099720109477"
ami_name_pattern = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-20260610"

# ---- Not configurable, and that is the point --------------------------------
#
# Root volume encryption, http_tokens and the metadata hop limit are hardcoded
# in main.tf: a security control exposed as a variable becomes optional.
