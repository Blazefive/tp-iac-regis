# Copy to backend.hcl (git-ignored), or run `make bootstrap` which creates the
# bucket and writes this file. A backend block accepts no variables, so partial
# configuration is the only way to keep the account id - embedded in the bucket
# name - out of a public repository.
#
#   terraform init -backend-config=backend.hcl

bucket = "tp-iac-regis-tfstate-000000000000"
